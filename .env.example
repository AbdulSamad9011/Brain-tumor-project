# --- LLM providers (report narration only — never used for pixel-level decisions) ---
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Model checkpoints ---
CLASSIFIER_CKPT_PATH=checkpoints/classifier.pt
SEGMENTATION_CKPT_PATH=checkpoints/segmentation.pt

# --- Inference ---
DEVICE=cpu                  # cuda | cpu | mps
CLASSIFIER_INPUT_SIZE=224
SEGMENTATION_INPUT_SIZE=128
CONFIDENCE_THRESHOLD=0.5

# --- Report generation ---
REPORT_MODEL=groq:openai/gpt-oss-120b
